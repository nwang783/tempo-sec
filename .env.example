# Tempo Sec Environment Variables
# Copy this file to .env and fill in your API keys

# ===================
# LLM Provider Keys
# ===================

# Anthropic (Claude) - Required for anthropic/* models
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI - Required for openai/* models
OPENAI_API_KEY=sk-your-key-here

# Google Gemini - Required for gemini/* models
GEMINI_API_KEY=your-gemini-key-here

# ===================
# Optional Settings
# ===================

# Custom API base URL (for proxies or self-hosted models)
# OPENAI_API_BASE=https://api.openai.com/v1
# ANTHROPIC_API_BASE=https://api.anthropic.com

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
