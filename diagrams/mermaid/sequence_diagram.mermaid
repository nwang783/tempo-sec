sequenceDiagram
    participant U as User
    participant SC as Script (recon/test_cycle)
    participant A as Agent
    participant SH as StepHandler
    participant C as ContextStore
    participant P as PromptBuilder
    participant T as ToolRegistry
    participant L as LLMClient
    participant EB as EventBus
    participant V as VisualizationServer
    
    U->>SC: python main.py
    SC->>A: run(objective)
    
    loop Each Step
        A->>C: render_messages()
        C-->>A: messages[]
        
        A->>P: build_system_prompt(phase)
        P-->>A: prompt
        
        A->>T: get_schemas()
        T-->>A: schemas[]
        
        A->>L: complete(messages, tools)
        L-->>A: LLMResponse
        
        A->>EB: emit(step_event)
        EB->>V: broadcast(step_event)
        
        alt Tool Call Requested
            A->>SH: handle_tool_call(request)
            SH->>T: get(tool_name)
            T-->>SH: Tool
            SH->>SH: execute(input)
            SH-->>A: ToolResult
            
            A->>C: add_tool_call()
            A->>EB: emit(tool_call_event)
            EB->>V: broadcast(tool_call_event)
            
            Note over A,C: Agent may call summarize_tool_output
        else Phase Transition
            A->>A: workflow.transition(phase)
            A->>EB: emit(phase_event)
            EB->>V: broadcast(phase_event)
        else Content Response
            A->>C: add_message()
        end
    end
    
    A-->>SC: AgentResult
    SC-->>U: Final output